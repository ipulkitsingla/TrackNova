{
  "name": "tracknova",
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-friendly Live Train Tracking PWA powered by Railcore API",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1"
  },
  "keywords": [
    "railcore",
    "train-tracking",
    "pwa",
    "indian-railways",
    "mern"
  ],
  "author": "",
  "license": "ISC"
}
